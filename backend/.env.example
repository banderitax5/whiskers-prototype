# Supabase project URL (Settings > API > Project URL)
SUPABASE_URL=

# Supabase service_role key (Settings > API > service_role key)
# WARNING: This key bypasses RLS — keep it secret
SUPABASE_SERVICE_KEY=

# Supabase anon key (Settings > API > anon/public key)
# Used for user-facing queries so RLS policies are enforced
SUPABASE_ANON_KEY=

# 32-byte base64-encoded key for AES-256-GCM encryption of PII
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Server port (default: 4141)
PORT=4141

# Set to 1 ONLY when the API is reached through a proxy you control
# (vite proxy / cloudflared tunnel). Enables trust-proxy handling and lets
# rate limits key on Cloudflare's client IP instead of 127.0.0.1.
# Leave unset for direct access, otherwise clients can spoof their IP.
# TRUST_PROXY=1

# Optional: secret for step-up (password re-verification) tokens.
# If unset, a key is derived from ENCRYPTION_KEY automatically.
# STEP_UP_SECRET=

# How long a step-up token stays valid, in seconds (default: 300)
# STEP_UP_TTL_SECONDS=300

# Transactional email (order receipts, order status updates, support replies)
# via Brevo's HTTP API. Leave BREVO_API_KEY unset to disable email entirely -
# checkout then works exactly as before, and the server logs
# "Order receipt not emailed".
# Get the key at brevo.com > SMTP & API > API keys (v3). The only permission
# needed is "Transactional email: All".
# MAIL_FROM_EMAIL must be a sender you verified on the Brevo Senders page.
# A sender on a domain you authenticated in Brevo (DKIM/SPF/DMARC aligned)
# delivers far better than a Gmail address - use that whenever you have one.
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=shop@yourdomain.com
# MAIL_FROM_NAME=Whiskers Pet Shop

# Explicit mail kill-switch for E2E/probe runs. Set MAIL_DISABLED=1 in the
# SERVER'S environment (not in this file) to skip every send even when the
# Brevo key is loaded - useful because pre-setting an empty BREVO_API_KEY on
# Windows is unreliable (PowerShell drops empty vars, dotenv re-fills).
# MAIL_DISABLED=1

# ─── Online payments (PayMongo hosted checkout) ────────────────────────────
# Leave PAYMONGO_SECRET_KEY unset to keep the built-in SIMULATED pay page
# (/pay/simulate) - that is what local dev and the E2E suite use.
#
# Setting a secret key switches GCash / Maya orders to PayMongo's hosted
# checkout page: POST /api/orders returns PayMongo's checkout_url, the shopper
# pays there, and the signed webhook below marks the order paid. While it is
# set, the simulate endpoint is closed (a client can never fake a payment).
#
# Keys: dashboard.paymongo.com > Developers > API keys
#   sk_test_...  sandbox (fake money, use during integration)
#   sk_live_...  real money
# PAYMONGO_SECRET_KEY=
#
# Webhook signing secret: dashboard > Developers > Webhooks (or the `secret`
# returned by POST https://api.paymongo.com/v1/webhooks). Test and live mode
# have DIFFERENT secrets - paste the one matching the key mode above.
# Endpoint to register: https://YOUR_DOMAIN/api/payments/paymongo/webhook
# Event: checkout_session.payment.paid
# PAYMONGO_WEBHOOK_SECRET=
#
# Public origin used for the success/cancel redirects PayMongo sends shoppers
# back to. Defaults to https://whiskerspet.me when unset.
# PUBLIC_SITE_URL=https://whiskerspet.me
#
# Minutes before an unpaid online order is cancelled and its stock returned
# (default: 30; set 1 for a walkthrough demo).
# GATEWAY_TTL_MINUTES=30
