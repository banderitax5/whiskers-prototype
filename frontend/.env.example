# Supabase — required. Find both values in Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Backend API base path (optional). Default: /api — requests go through the Vite dev proxy.
# VITE_API_BASE=/api

# Where the dev proxy sends /api requests (optional). Default: http://localhost:4141
# VITE_PROXY_TARGET=http://localhost:4141
